{
    "version": "2.0.0",
    "options": {
        "cwd": "${workspaceFolder}"
    },
    "tasks": [
        {
            "label": "verify",
            "type": "process",
            "command": "pwsh",
            "args": ["-NoProfile", "-NonInteractive", "-File", "${workspaceFolder}${pathSeparator}build.ps1", "-Task", "Verify"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "build",
            "type": "process",
            "command": "pwsh",
            "args": ["-NoProfile", "-NonInteractive", "-File", "${workspaceFolder}${pathSeparator}build.ps1", "-Task", "Build"],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "test",
            "type": "process",
            "command": "pwsh",
            "args": ["-NoProfile", "-NonInteractive", "-File", "${workspaceFolder}${pathSeparator}build.ps1", "-Task", "Test"],
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "package",
            "type": "process",
            "command": "pwsh",
            "args": ["-NoProfile", "-NonInteractive", "-File", "${workspaceFolder}${pathSeparator}build.ps1", "-Task", "Package"],
            "group": "build",
            "problemMatcher": []
        }
    ]
}
